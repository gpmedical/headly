{
  "expo": {
    "name": "headly",
    "slug": "headly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/headly-icon.png",
    "scheme": "headly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/headly-icon.png",
      "bundleIdentifier": "com.gpmedical.headly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/headly-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gpmedical.headly"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Poppins",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Poppins-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Poppins-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Poppins-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          },
          "ios": [
            "./assets/fonts/Poppins-Regular.ttf",
            "./assets/fonts/Poppins-Medium.ttf",
            "./assets/fonts/Poppins-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "116cb5db-0eb5-4763-90a5-08971bca6f64"
      }
    }
  }
}
